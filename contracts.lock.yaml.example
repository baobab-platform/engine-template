# Example EA-01 consumer lock. Copy to contracts.lock.yaml and set source.commit
# to a commit on baobab-platform/shared main that this engine is built against.
# See baobab-platform/shared/scripts/contract_lock.py and
# .baobab/contract-consumer-lock.schema.json.
#
# schema: baobab-contract-consumer-lock
# version: "1.0"
# source:
#   repository: baobab-platform/shared
#   commit: REPLACE_WITH_SHARED_MAIN_COMMIT_SHA
# contracts:
#   - contracts/identity/v1/principal.schema.json
# policy:
#   updates: explicit_pull_request
#   compatibility: validate_before_merge

schema: baobab-contract-consumer-lock
version: "1.0"
source:
  repository: baobab-platform/shared
  commit: "0000000000000000000000000000000000000000"
contracts: []
policy:
  updates: explicit_pull_request
  compatibility: validate_before_merge
