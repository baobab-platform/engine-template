{
  "name": "engine-template Development",
  "image": "ghcr.io/baobab-platform/baobab-dev:1.4.4",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "init": true,
  "postCreateCommand": "printf 'Codespace ready; configure runtime and dependencies manually\\n'",
  "waitFor": "postCreateCommand",
  "customizations": {
    "vscode": {
      "extensions": [
        "github.vscode-github-actions",
        "redhat.vscode-yaml"
      ]
    }
  }
}
