# Target path: <new-repo>/.baobab/repository.yaml
schema_version: 1
repository:
  lifecycle: experimental
capabilities:
  - engine
  # Add only capabilities backed by real repository evidence.
environment:
  baobab_dev:
    required: true
    profile: full # Choose the narrowest applicable profile.
artifacts:
  container: false # Or use the object below when an artifact is published.
  # container:
  #   enabled: true
  #   dockerfile: Dockerfile
  #   context: .
  #   runtime: true # false only for static OCI bundles such as contract archives.
